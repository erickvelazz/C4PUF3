            st.warning(f"{len(s.pend_sin):,} pendientes (status 4/8) sin placa con score ≥ {umbral_placa}%. Revisión manual.")
            st.dataframe(s.pend_sin, use_container_width=True, hide_index=True, height=380)

    # Tab 6 — Descartados
    with t6:
        if s.descartados.empty:
